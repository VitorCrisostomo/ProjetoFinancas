# Gere uma chave local: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
APP_ENV=development

# Apenas no desenvolvimento local com HTTP. Para HTTPS, use true.
AUTH_COOKIE_SECURE=false
# Origens exatas; em produção, informe o endereço HTTPS da aplicação.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite relativo à pasta instance/ do Flask.
DATABASE_URI=sqlite:///financehub.db

# Chave dos dados separada do JWT e do banco. Caminho absoluto recomendado em produção.
# Se omitido, usa backend/.secrets/financial-data-keys.json.
DATA_ENCRYPTION_KEY_FILE=

# Produção: prepare_state.py gera app.env externo com todos os caminhos absolutos.
# FINANCEHUB_ENV_FILE aponta para esse arquivo ao iniciar o processo.
# BACKUP_DIRECTORY=/caminho/absoluto/para/backups

# Credenciais individuais da Pluggy são gravadas aqui pelos comandos administrativos:
# python -m flask --app main create-user
# python -m flask --app main reset-password
# python -m flask --app main configure-pluggy
# Formato gerenciado (REFERENCIA é a identidade permanente do usuário sem hífens):
# PLUGGY_USER_<REFERENCIA>_CLIENT_ID='...'
# PLUGGY_USER_<REFERENCIA>_CLIENT_SECRET='...'
# PLUGGY_CLIENT_ID/PLUGGY_CLIENT_SECRET globais não são usados como fallback.
