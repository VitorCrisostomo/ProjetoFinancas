# Gere uma chave local: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Apenas no desenvolvimento local com HTTP. Para HTTPS, use true.
AUTH_COOKIE_SECURE=false
# Origens exatas; em produção, informe o endereço HTTPS da aplicação.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite relativo à pasta instance/ do Flask.
DATABASE_URI=sqlite:///financehub.db

# Preencha com as credenciais da sua integração Pluggy.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
