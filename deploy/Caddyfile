{
	admin off
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
		trusted_proxies_strict
	}
}

:8080 {
	bind 127.0.0.1
	@wrongHost not host {$APP_HOST}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	# route preserva a ordem: rejeita o Host antes do proxy e dos arquivos estáticos.
	route {
		respond @wrongHost "Host não autorizado" 421
		handle_path /api/* {
			reverse_proxy 127.0.0.1:8000 {
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {$APP_HOST}
				header_up -Forwarded
				header_up -X-Forwarded-Prefix
			}
		}
		handle /api {
			respond "Not found" 404
		}
		handle {
			root * "{$FRONTEND_ROOT}"
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@document not path /assets/*
			header @document Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
